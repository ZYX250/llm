# 通义千问 API Key（必填）
# 申请地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-api-key-here

# 服务端口（可选，默认即可）
BACKEND_PORT=8000
FRONTEND_PORT=5173

# 评审模式令牌（可选）。设置后启用 /reviewer/* 只读端点，供评委查看检索打分、
# RRF 配置、引用判定明细与图谱边来源；不设置则这些端点返回 503，正常功能不受影响。
# 建议生成一个随机串，例如：python -c "import secrets;print(secrets.token_urlsafe(16))"
REVIEWER_TOKEN=

# CORS 白名单（可选，逗号分隔）。默认只放行 http://localhost:5173 与 http://127.0.0.1:5173。
# 用公网隧道演示时可设为 *（此时自动关闭 allow_credentials，避免浏览器丢弃凭证的非法组合）。
ALLOW_ORIGINS=
